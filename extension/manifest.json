{
  "manifest_version": 3,
  "name": "Riftbound en français",
  "version": "1.26.1",
  "description": "Traduction francaise des cartes Riftbound au survol, sur Rift Atlas et dans le simulateur. Mots-cles en anglais comme sur la carte, phrases en francais.",
  "content_scripts": [
    {
      "matches": [
        "https://riftatlas.com/*",
        "https://www.riftatlas.com/*",
        "https://play.riftatlas.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fr.json"
      ],
      "matches": [
        "https://riftatlas.com/*",
        "https://www.riftatlas.com/*",
        "https://play.riftatlas.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://rift-explique.github.io/*",
    "https://riftatlas.com/*",
    "https://www.riftatlas.com/*",
    "https://play.riftatlas.com/*"
  ],
  "permissions": [
    "storage",
    "scripting"
  ],
  "action": {
    "default_title": "Riftbound en français",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
